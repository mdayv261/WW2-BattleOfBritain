{
  "name": "ww2-battle-of-britain",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "fit:ballistics": "node scripts/fitBallistics.mjs",
    "fit:rig": "node scripts/fitRig.mjs",
    "handling": "node scripts/handling.mjs",
    "duels": "node scripts/duels.mjs",
    "build:terrain": "node scripts/buildTerrain.mjs",
    "build:features": "node scripts/buildFeatures.mjs",
    "mp:setup": "npm --prefix server install --no-audit --no-fund",
    "mp:server": "mkdir -p server/public && npm --prefix server run dev",
    "mp:smoke": "node scripts/mpSmoke.mjs",
    "mp:load": "node scripts/mpLoad.mjs",
    "mp:testcopy": "VITE_MP_SERVER=same-origin vite build --base / --outDir server/public --emptyOutDir",
    "mp:deploy": "npm run mp:testcopy && npm --prefix server run deploy"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
